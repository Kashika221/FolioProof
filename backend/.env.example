# --- Groq (required) -------------------------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Model used for structured extraction + grounded rewriting
GROQ_MODEL=openai/gpt-oss-120b
# Smaller/faster model used for per-sentence entailment checks

# --- GitHub (optional but strongly recommended) ----------------------------
# Unauthenticated = 60 requests/hour. A classic token with public_repo scope
# raises this to 5000/hour. https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Pluggable backends ----------------------------------------------------

# tfidf = char-ngram TF-IDF cosine (no download)
# sbert = sentence-transformers all-MiniLM-L6-v2 (requires torch)
EMBEDDING_BACKEND=tfidf

# --- Storage ---------------------------------------------------------------
# Local server, or a free MongoDB Atlas cluster:
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=folioproof

# --- deployment ------------------------------------------------------------
# Origins allowed to call this API. In production set this to your deployed
# frontend, e.g. https://folioproof.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=./data/uploads
CACHE_DIR=./data/cache

# --- Tuning ----------------------------------------------------------------
# Cosine/fuzzy score above which a resume project and a GitHub repo are
# considered the same entity.
ENTITY_MATCH_THRESHOLD=0.62
